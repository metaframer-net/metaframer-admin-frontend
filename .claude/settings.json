{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "language": "turkish",
  "permissions": {
    "defaultMode": "acceptEdits",
    "deny": [
      "Bash(git commit:*)",
      "Bash(git commit)",
      "Bash(git push:*)",
      "Bash(git push)",
      "Bash(git reset:*)",
      "Bash(git rebase:*)",
      "Bash(git tag:*)",
      "Bash(git merge:*)",
      "Bash(git checkout:*)",
      "Bash(git restore:*)",
      "Bash(git clean:*)",
      "Bash(git stash:*)",
      "Bash(git cherry-pick:*)",
      "Bash(git revert:*)",
      "Bash(git rm:*)",
      "Bash(rm -rf:*)",
      "Bash(sudo:*)",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Read(./.env)",
      "Read(./.env.*)"
    ],
    "allow": [
      "Read", "Grep", "Glob", "Edit", "Write",
      "Bash(git status)", "Bash(git status:*)", "Bash(git diff:*)", "Bash(git log:*)", "Bash(git show:*)",
      "Bash(npm run:*)", "Bash(npm ci)", "Bash(npm install:*)", "Bash(npm test:*)", "Bash(npm create:*)",
      "Bash(npx:*)", "Bash(node:*)",
      "Bash(mkdir:*)", "Bash(ls:*)", "Bash(cat:*)", "Bash(cp:*)", "Bash(mv:*)", "Bash(touch:*)", "Bash(rm:*)"
    ]
  },
  "attribution": { "coAuthoredBy": false },
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "bash scripts/hooks/mechanical-check.sh"
          }
        ]
      }
    ]
  }
}
